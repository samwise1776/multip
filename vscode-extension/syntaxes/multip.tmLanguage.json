{
  "name": "Multip",
  "scopeName": "source.multip",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#colors" },
    { "include": "#units" },
    { "include": "#keywords" },
    { "include": "#ui-elements" },
    { "include": "#operators" },
    { "include": "#punctuation" },
    { "include": "#functions" },
    { "include": "#properties" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.multip",
          "match": "//.*$"
        },
        {
          "name": "comment.block.multip",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.multip",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.multip",
              "match": "\\\\(n|t|r|\\\\|\"|')"
            }
          ]
        },
        {
          "name": "string.quoted.single.multip",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.multip",
              "match": "\\\\(n|t|r|\\\\|\"|')"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.multip",
          "match": "\\b-?\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.multip",
          "match": "\\b-?\\d+\\b"
        }
      ]
    },
    "colors": {
      "patterns": [
        {
          "name": "constant.other.color.multip",
          "match": "#[0-9a-fA-F]{3,8}\\b"
        }
      ]
    },
    "units": {
      "patterns": [
        {
          "name": "keyword.other.unit.multip",
          "match": "\\b\\d+(ms|px|s|em|rem|%|pt|vh|vw|deg|rad)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.multip",
          "match": "\\b(if|else|while|for|in|return|break|continue|async|await|try|catch|throw)\\b"
        },
        {
          "name": "keyword.declaration.multip",
          "match": "\\b(page|component|route|class|interface|enum|function|var|const|let|import|from|as|database|server|animate)\\b"
        },
        {
          "name": "keyword.other.multip",
          "match": "\\b(new|this|super|self|null|true|false|typeof|instanceof|extends|implements)\\b"
        }
      ]
    },
    "ui-elements": {
      "patterns": [
        {
          "name": "support.type.builtin.multip",
          "match": "\\b(window|column|row|text|button|heading|paragraph|image|input|textfield|box|space|divider|toolbar|browserView|urlbox|backButton|forwardButton|refreshButton|homeButton|goButton)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.multip",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.assignment.multip",
          "match": "(\\+=|-=|\\*=|/=|=)"
        },
        {
          "name": "keyword.operator.arithmetic.multip",
          "match": "(\\+|\\-|\\*|/|%)"
        },
        {
          "name": "keyword.operator.logical.multip",
          "match": "(&&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.arrow.multip",
          "match": "(->|=>)"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.brace.curly.multip",
          "match": "[{}]"
        },
        {
          "name": "punctuation.bracket.square.multip",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.parenthesis.multip",
          "match": "[()]"
        },
        {
          "name": "punctuation.separator.comma.multip",
          "match": ","
        },
        {
          "name": "punctuation.separator.colon.multip",
          "match": ":"
        },
        {
          "name": "punctuation.separator.dot.multip",
          "match": "\\."
        },
        {
          "name": "punctuation.terminator.multip",
          "match": ";"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.multip",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()"
        }
      ]
    },
    "properties": {
      "patterns": [
        {
          "name": "variable.other.property.multip",
          "match": "(on\\s+(click|enter|submit|change|hover|focus|blur))\\b"
        },
        {
          "name": "variable.other.property.multip",
          "match": "\\b(text|value|title|size|color|background|foreground|padding|margin|width|height|src|placeholder|cols|duration|url|id|name|type|class)\\s*(?==)"
        }
      ]
    }
  }
}
