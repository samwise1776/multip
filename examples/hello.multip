page Home

window {
    title = "My First App"

    column {
        padding = 40

        heading {
            text = "Hello, World!"
            size = 36
            color = #7C3AED
        }

        text {
            value = "Welcome to Multip"
            size = 18
        }

        button {
            text = "Click Me"

            on click {
                print("Hello from Multip!")
            }
        }
    }
}