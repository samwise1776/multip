page Home


window {
    title = "Multip Welcome"


    column {
        padding = 40


        heading {
            text = "Welcome to Multip"
            size = 36
            color = #27273f
        }


        text {
            value = "A unified programming language for everything."
            size = 18
        }


        button {
            text = "Get Started"


            on click {
                print("Hello from Multip!")
            }
        }
    }
}
