component Card(title, body) {
    column {
        heading {
            text = title
            size = 24
        }

        paragraph {
            text = body
            size = 16
        }
    }
}


page Home


window {
    title = "Components Demo"


    column {
        padding = 30

        Card("First Card", "This is the first card component.")
        Card("Second Card", "This is the second card component.")
        Card("Third Card", "This is the third card component.")
    }
}
